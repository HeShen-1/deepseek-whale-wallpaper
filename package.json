{
  "name": "dsh-plugin-harness-whale",
  "version": "0.2.0",
  "description": "DeepSeek Harness particle-whale wallpaper for the web client",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeShen-1/deepseek-whale-wallpaper.git"
  },
  "homepage": "https://heshen-1.github.io/deepseek-whale-wallpaper/",
  "bugs": {
    "url": "https://github.com/HeShen-1/deepseek-whale-wallpaper/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "wallpaper",
    "webgl",
    "particles",
    "theme",
    "plugin"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
